"Un email avec les instructions de réinitialisation de mot de passe a été "
"envoyé."
msgstr ""
"An email containing instructions on how to reset your password has been "
"sent."

#: project/auth.py:269
msgid "Le lien de réinitialisation de mot de passe est invalide ou a expiré."
msgstr "The password reset link is invalid or has expired."

#: project/auth.py:279 project/auth.py:359

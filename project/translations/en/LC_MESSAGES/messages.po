msgstr "The passwords do not match."

#: project/auth.py:292
msgid "Votre mot de passe a été réinitialisé avec succès."
msgstr "Your password has been successfully reset."

#: project/auth.py:324
msgid "Vous devez indiquer votre nom."
msgstr "You must enter your name."

#: project/auth.py:334
msgid "Cette adresse email est déjà utilisée."
msgstr "This email address is already in use."

#: project/auth.py:340
msgid "Un e-mail de vérification a été envoyé à votre nouvelle adresse."

msgstr ""

#: project/templates/apropos.html:35
msgid "Gérer les prêts et les retours des élèves."
msgstr ""

#: project/templates/apropos.html:36
msgid "Consulter l'historique des emprunts."
msgstr ""

#: project/templates/apropos.html:37
msgid "Identifier les livres les plus lus."
msgstr ""

#: project/templates/apropos.html:38
msgid ""
"Accéder à votre bibliothèque depuis un ordinateur, une tablette ou un "
"smartphone."
msgstr ""

#: project/templates/apropos.html:43
msgid ""
"Notre objectif est simple : permettre aux enseignants de consacrer moins "
"de temps à l'administration et davantage à la lecture et à "
"l'accompagnement de leurs élèves."
msgstr ""


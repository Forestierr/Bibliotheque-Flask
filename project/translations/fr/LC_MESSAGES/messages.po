msgid "Papier recommandé"
msgstr "Papier recommandé"

#: project/templates/ressources/diplome.html:371
msgid ""
"Utilisez un papier blanc épais couché mat ou bristol de 200 à 250 g/m² "
"pour conférer au document un aspect officiel et solennel."
msgstr "Utilisez un papier blanc épais couché mat ou bristol de 200 à 250 g/m² pour conférer au document un aspect officiel et solennel."


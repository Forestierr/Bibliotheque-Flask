msgid "Orientation"
msgstr "Orientation"

#: project/templates/ressources/diplome.html:372
msgid ""
"Le document est configuré en A4 paysage avec des marges d'impression "
"intégrées. Choisissez « Ajuster à la page » ou échelle normale dans la "
"boîte de dialogue de votre imprimante."
msgstr "Le document est configuré en A4 paysage avec des marges d'impression intégrées. Choisissez « Ajuster à la page » ou échelle normale dans la boîte de dialogue de votre imprimante."


"Si vous possédez un compte Livres en Classe, connectez-vous pour générer "
"en 1 clic les diplômes pré-remplis de tous les élèves avec leur nombre "
"exact de livres lus."
msgstr "Si vous possédez un compte Livres en Classe, connectez-vous pour générer en 1 clic les diplômes pré-remplis de tous les élèves avec leur nombre exact de livres lus."

#: project/templates/ressources/diplome.html:382
msgid "Suivi automatique des emprunts"
msgstr "Suivi automatique des emprunts"

#: project/templates/ressources/diplome.html:385
msgid "Comptez automatiquement les livres lus par chaque élève"
msgstr "Comptez automatiquement les livres lus par chaque élève"

#: project/templates/ressources/diplome.html:388
msgid ""
"Livres en Classe enregistre chaque retour d'emprunt et calcule en temps "
"réel le nombre de livres lus par élève. Générez vos bilans de lecture "
"trimestriels et diplômes en un instant."
msgstr "Livres en Classe enregistre chaque retour d'emprunt et calcule en temps réel le nombre de livres lus par élève. Générez vos bilans de lecture trimestriels et diplômes en un instant."


#: project/templates/mentions-legales.html:36
msgid "1. CONDITIONS D'UTILISATION"
msgstr "1. NUTZUNGSBEDINGUNGEN"

#: project/templates/mentions-legales.html:51
msgid "2. UTILISATION EXCLUSIVEMENT PRIVÉE"
msgstr "2. AUSSCHLIESSLICH PRIVATE NUTZUNG"


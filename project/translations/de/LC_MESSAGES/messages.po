#: project/admin.py:631
msgid "Pour vous désabonner :"
msgstr "Zum Abmelden:"

#: project/admin.py:632
msgid "Donner votre avis :"
msgstr "Ihre Meinung äußern:"

#: project/admin.py:633
msgid "Signaler un problème :"
msgstr "Ein Problem melden:"

#: project/auth.py:76 project/auth.py:147 project/templates/auth/login.html:159
#: project/templates/auth/signup.html:265
msgid "Veuillez compléter le CAPTCHA."
msgstr "Bitte füllen Sie das CAPTCHA aus."

#: project/auth.py:85 project/auth.py:157
msgid "CAPTCHA invalide. Veuillez réessayer."
msgstr "Ungültiges CAPTCHA. Bitte versuchen Sie es erneut."

#: project/auth.py:94
msgid "Vérifier si votre email et votre mot de passe sont correcte."
msgstr ""
"Bitte überprüfen Sie, ob Ihre E-Mail-Adresse und Ihr Passwort korrekt "
"sind."

#: project/auth.py:101
msgid "Veuillez vérifier votre adresse e-mail avant de vous connecter."
msgstr "Bitte bestätigen Sie Ihre E-Mail-Adresse, bevor Sie sich anmelden."

#: project/auth.py:167
msgid "Cette email est déjà utilisé."
msgstr "Diese E-Mail-Adresse wird bereits verwendet."

#: project/auth.py:201
msgid ""
"Un e-mail de vérification vous a été envoyé. Veuillez vérifier votre "
"boîte de réception."
msgstr ""
"Eine Bestätigungs-E-Mail wurde an Sie gesendet. Bitte überprüfen Sie "
"Ihren Posteingang."

#: project/auth.py:212
msgid "Le lien de vérification est invalide ou a expiré."
msgstr "Der Bestätigungslink ist ungültig oder abgelaufen."

#: project/auth.py:216
msgid "Votre compte est déjà vérifié."
msgstr "Ihr Konto ist bereits bestätigt."

#: project/auth.py:223
msgid ""
"Votre adresse e-mail a été vérifiée avec succès. Vous pouvez maintenant "
"vous connecter."
msgstr ""
"Ihre E-Mail-Adresse wurde erfolgreich bestätigt. Sie können sich jetzt "
"anmelden."

#: project/auth.py:242 project/auth.py:328
msgid "Vous devez indiquer votre email."
msgstr "Sie müssen Ihre E-Mail-Adresse angeben."

#: project/auth.py:248
msgid "Aucun utilisateur trouvé avec cet email."
msgstr "Kein Benutzer mit dieser E-Mail-Adresse gefunden."

#: project/auth.py:253
msgid ""
"Un email avec les instructions de réinitialisation de mot de passe a été "
"envoyé."
msgstr ""
"Eine E-Mail mit Anweisungen zum Zurücksetzen Ihres Passworts wurde "
"gesendet."

#: project/auth.py:269
msgid "Le lien de réinitialisation de mot de passe est invalide ou a expiré."
msgstr "Der Link zum Zurücksetzen des Passworts ist ungültig oder abgelaufen."

#: project/auth.py:279 project/auth.py:359
msgid "Vous devez indiquer un nouveau mot de passe."
msgstr "Sie müssen ein neues Passwort eingeben."

#: project/auth.py:285
msgid "Les mots de passe ne correspondent pas."
msgstr "Die Passwörter stimmen nicht überein."

#: project/auth.py:292
msgid "Votre mot de passe a été réinitialisé avec succès."
msgstr "Ihr Passwort wurde erfolgreich zurückgesetzt."

#: project/auth.py:324
msgid "Vous devez indiquer votre nom."
msgstr "Sie müssen Ihren Namen angeben."

#: project/auth.py:334
msgid "Cette adresse email est déjà utilisée."
msgstr "Diese E-Mail-Adresse wird bereits verwendet."

#: project/auth.py:340
msgid "Un e-mail de vérification a été envoyé à votre nouvelle adresse."
msgstr "Eine Bestätigungs-E-Mail wurde an Ihre neue E-Mail-Adresse gesendet."

#: project/auth.py:356
msgid "Votre mot de passe est incorrect."
msgstr "Ihr Passwort ist falsch."

#: project/auth.py:364
msgid "Vous devez indiquer votre mot de passe actuel."
msgstr "Sie müssen Ihr aktuelles Passwort eingeben."

#: project/auth.py:368
msgid "Vos informations ont été mises à jour."
msgstr "Ihre Informationen wurden aktualisiert."

#: project/eleve.py:45
#, python-format
msgid ""
"Vous avez atteint la limite de %(max)s élèves du plan gratuit. Vos élèves"
" existants restent utilisables. Pour en ajouter d'autres, passez Premium "
"ou supprimez un élève existant."
msgstr ""
"Sie haben das Limit von %(max)s Schülern im kostenlosen Tarif erreicht. "
"Ihre bestehenden Schüler bleiben erhalten. Um weitere hinzuzufügen, "
"wechseln Sie zu Premium oder löschen Sie einen bestehenden Schüler."

#: project/eleve.py:61 project/main.py:204
msgid "Veuillez remplir tous les champs."
msgstr "Bitte füllen Sie alle Felder aus."

#: project/eleve.py:69
msgid "L'élève existe déjà."
msgstr "Der Schüler existiert bereits."

#: project/emprunt.py:72 project/emprunt.py:93
msgid "Accès non autorisé."
msgstr "Nicht autorisierter Zugriff."

#: project/emprunt.py:87
msgid "Emprunt introuvable."
msgstr "Ausleihe nicht gefunden."

#: project/livre.py:143
msgid "Le livre que vous souhaitiez voir n'existe pas."
msgstr "Das gesuchte Buch existiert nicht."

#: project/livre.py:178
#, python-format
msgid ""
"Vous avez atteint la limite de %(max)s livres du plan gratuit. Vos livres"
" existants restent utilisables. Pour en ajouter d'autres, passez Premium "
"ou supprimez un livre existant."
msgstr ""
"Sie haben das Limit von %(max)s Büchern im kostenlosen Tarif erreicht. "
"Ihre bestehenden Bücher bleiben erhalten. Um weitere hinzuzufügen, "
"wechseln Sie zu Premium oder löschen Sie ein bestehendes Buch."

#: project/livre.py:203
msgid "Veuillez ajouter un titre."
msgstr "Bitte geben Sie einen Titel ein."

#: project/livre.py:248
msgid "Le livre : "
msgstr "Das Buch: "

#: project/livre.py:248
msgid " a été ajouté à votre bibliothèque."
msgstr " wurde Ihrer Bibliothek hinzugefügt."

#: project/livre.py:308
msgid "Le livre que vous souhaitiez éditer n'existe pas."
msgstr "Das Buch, das Sie bearbeiten möchten, existiert nicht."

#: project/livre.py:342
msgid "Veuillez ajouter un titre au livre."
msgstr "Bitte geben Sie dem Buch einen Titel."

#: project/livre.py:430
msgid "Le livre que vous souhaitiez dupliquer n'existe pas."
msgstr "Das Buch, das Sie duplizieren möchten, existiert nicht."

#: project/livre.py:465
msgid "Le livre reste dans la bibliothèque."
msgstr "Das Buch bleibt in der Bibliothek."

#: project/livre.py:471
msgid "L'élève n'existe pas."
msgstr "Der Schüler existiert nicht."

#: project/livre.py:495
msgid "Le livre a été supprimé."
msgstr "Das Buch wurde gelöscht."

#: project/livre.py:513
#, python-format
msgid ""
"Vous avez scanné %(max)s livres ! Passez Premium à 30.- CHF/an pour "
"scanner en illimité."
msgstr ""
"Sie haben %(max)s Bücher gescannt! Wechseln Sie für 30.- CHF/Jahr zu "
"Premium für unbegrenztes Scannen."

#: project/livre.py:556
msgid "Tous les livres ont été supprimés."
msgstr "Alle Bücher wurden gelöscht."

#: project/main.py:226
msgid ""
"Votre message a été envoyé avec succès. Vous avez reçu un email de "
"confirmation."
msgstr ""
"Ihre Nachricht wurde erfolgreich gesendet. Sie haben eine "
"Bestätigungs-E-Mail erhalten."

#: project/main.py:288
msgid "Veuillez renseigner l'objet et la description de votre retour."
msgstr "Bitte geben Sie Betreff und Beschreibung Ihres Feedbacks an."

#: project/main.py:323
msgid "Votre retour a été transmis avec succès. Merci pour votre aide précieuse !"
msgstr ""
"Ihr Feedback wurde erfolgreich übermittelt. Vielen Dank für Ihre "
"wertvolle Hilfe!"

#: project/main.py:379
msgid "Article non trouvé"
msgstr "Artikel nicht gefunden"

#: project/main.py:389
msgid "Guide non trouvé"
msgstr "Leitfaden nicht gefunden"

#: project/ressource.py:156
msgid "Ressource non trouvée"
msgstr "Ressource nicht gefunden"

#: project/subscription.py:58
msgid "Cette fonctionnalité nécessite un abonnement Premium."
msgstr "Diese Funktion erfordert ein Premium-Abonnement."

#: project/subscription.py:65
msgid "Cette fonctionnalité est réservée aux membres Premium."
msgstr "Diese Funktion ist Premium-Mitgliedern vorbehalten."

#: project/subscription.py:118
msgid ""
"Le service de paiement Stripe est en cours de configuration. Contactez "
"l'administrateur."
msgstr ""
"Der Stripe-Zahlungsdienst wird derzeit eingerichtet. Bitte kontaktieren "
"Sie den Administrator."

#: project/subscription.py:184
#, python-format
msgid "Une erreur est survenue lors de l'accès au paiement : %(error)s"
msgstr "Beim Zugriff auf die Zahlung ist ein Fehler aufgetreten: %(error)s"

#: project/subscription.py:203
msgid "Aucun abonnement Stripe actif n'est associé à votre compte pour le moment."
msgstr "Ihrem Konto ist derzeit kein aktives Stripe-Abonnement zugeordnet."

#: project/subscription.py:220
#, python-format
msgid "Impossible d'accéder au portail de gestion : %(error)s"
msgstr "Zugriff auf das Kundenportal nicht möglich: %(error)s"

#: project/templates/aide.html:7
msgid "Centre d'aide | Livres en Classe"
msgstr "Hilfecenter | Livres en Classe"

#: project/templates/aide.html:8
msgid ""
"Guides, tutoriels et FAQ pour utiliser Livres en Classe : scanner vos "
"livres, gérer vos élèves et effectuer vos premiers prêts."
msgstr ""
"Anleitungen, Tutorials und FAQ zur Nutzung von Livres en Classe: Bücher "
"scannen, Schüler verwalten und die ersten Ausleihen durchführen."


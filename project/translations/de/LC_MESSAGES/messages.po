#: project/templates/index.html:254
msgid "Récupération auto de l'auteur et du titre"
msgstr "Automatisches Abrufen von Autor und Titel"

#: project/templates/index.html:259
msgid "Consultable partout (Mobile / PC)"
msgstr "Überall abrufbar (Mobil / PC)"

#: project/templates/index.html:264
msgid "Statistiques automatiques de lecture"
msgstr "Automatische Lesestatistiken"

#: project/templates/index.html:269

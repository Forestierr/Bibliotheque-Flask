# This is an example of the .env file that you need to create in the root of the project
# You can copy this file and rename it to .env
# Fill in the values with your own values

# The .env file is used to store sensitive information that should not be shared with others

# Flask configuration
SECRET_KEY='your_secret_key'
LOG_LEVEL=INFO
SQLALCHEMY_DATABASE_URI='sqlite:///db.sqlite'

# Mail configuration
# see : https://mailtrap.io/blog/flask-send-email-gmail/
MAIL_SERVER='smtp.gmail.com'
MAIL_PORT=465
MAIL_USERNAME='your_email'
MAIL_PASSWORD='your_password'
MAIL_USE_TLS=False
MAIL_USE_SSL=True

# Google book API
# see : https://developers.google.com/books/docs/v1/using
GOOGLE_BOOK_API_KEY='your_google_book_api_key'

# CloudFlare configuration
# see : https://austinsnerdythings.com/2023/11/01/using-github-actions-to-deploy-a-flask-nginx-cloudflared-tunnel-docker-compose-stack/
CF_TOCKEN='your_cloudflare_tocken'

# hCaptcha configuration (anti-bot CAPTCHA)
# Créer un compte sur https://www.hcaptcha.com/ et ajouter votre site
# pour obtenir ces deux clés.
HCAPTCHA_SITE_KEY='your_hcaptcha_site_key'
HCAPTCHA_SECRET_KEY='your_hcaptcha_secret_key'

# Stripe configuration (Freemium & Abonnements)
# Obtenez vos clés et secret de webhook sur https://dashboard.stripe.com/
STRIPE_PUBLIC_KEY='pk_test_...'
STRIPE_SECRET_KEY='sk_test_...'
STRIPE_WEBHOOK_SECRET='whsec_...'
# IDs des prix Stripe (créés dans le Dashboard Stripe > Produits)
# Noms acceptés : STRIPE_PRICE_MONTHLY ou STRIPE_PRICE_ID_MONTHLY (les deux fonctionnent)
STRIPE_PRICE_MONTHLY='price_...'
STRIPE_PRICE_YEARLY='price_...'

# Flask configuration
SECRET_KEY='your_secret_key'
LOG_LEVEL=INFO
SQLALCHEMY_DATABASE_URI='sqlite:///db.sqlite'

# Mail configuration
# see : https://mailtrap.io/blog/flask-send-email-gmail/
MAIL_SERVER='smtp.gmail.com'
MAIL_PORT=465
MAIL_USERNAME='your_email'
MAIL_PASSWORD='your_password'
MAIL_USE_TLS=False
MAIL_USE_SSL=True

# CloudFlare configuration
# see : https://austinsnerdythings.com/2023/11/01/using-github-actions-to-deploy-a-flask-nginx-cloudflared-tunnel-docker-compose-stack/
CF_TOCKEN='your_cloudflare_tocken'
